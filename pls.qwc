<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Login — Ledger Pro</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#0f172a,#1e293b 55%,#312e81);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;color:#172033}
.card{width:min(440px,92vw);background:#fff;border-radius:20px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.35)}
.brand{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.mark{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#3b82f6,#7c3aed);display:grid;place-items:center;color:#fff;font-weight:800}
.brand b{display:block;font-size:17px}.brand small{color:#6b7688;font-size:12px}
.tabs{display:grid;grid-template-columns:1fr 1fr;background:#eef2f7;border-radius:12px;padding:4px;margin-bottom:18px}
.tab{border:0;background:transparent;padding:10px;border-radius:9px;font-weight:700;font-size:13px;color:#64748b;cursor:pointer}
.tab.active{background:#fff;color:#1d4ed8;box-shadow:0 2px 8px rgba(15,23,42,.1)}
label{display:block;font-size:11px;font-weight:700;color:#566176;text-transform:uppercase;letter-spacing:.05em;margin:14px 0 6px}
input{width:100%;padding:12px;border:1px solid #e5eaf0;border-radius:10px;font-size:14px;outline:none}
input:focus{border-color:#93c5fd;box-shadow:0 0 0 3px #dbeafe}
.go{width:100%;margin-top:20px;border:0;border-radius:10px;padding:13px;font-weight:800;font-size:14px;color:#fff;background:#2563eb;cursor:pointer}
.go.guest{background:#0f766e}
.note{font-size:12px;color:#6b7688;line-height:1.55;margin-top:6px}
.err{background:#fef2f2;color:#dc2626;border-radius:9px;padding:10px 12px;font-size:12px;margin-bottom:12px}
.pane{display:none}.pane.active{display:block}
</style></head><body>
<div class="card">
  <div class="brand"><div class="mark">R$</div><div><b>Ledger Pro</b><small>Rs → USD finance dashboard</small></div></div>
  
  <div class="tabs">
    <button type="button" class="tab active" data-pane="admin">Administrator</button>
    <button type="button" class="tab " data-pane="accountant">User Login</button>
    <button type="button" class="tab " data-pane="guest">Guest</button>
  </div>
  <form method="post" action="/login" class="pane active" id="admin">
    <input type="hidden" name="role" value="admin">
    <label>Username</label><input name="username" autocomplete="username" required>
    <label>Password</label><input name="password" type="password" autocomplete="current-password" required>
    <div class="note">Full access: upload sheets, set each sheet's USD rate, all reports and downloads.</div>
    <button class="go" type="submit">Login as Administrator</button>
  </form>
  <form method="post" action="/login" class="pane " id="accountant">
    <input type="hidden" name="role" value="accountant">
    <label>Username</label><input name="username" autocomplete="username" required>
    <label>Password</label><input name="password" type="password" autocomplete="current-password" required>
    <div class="note">View only: reports of your own studio. Other studios are not visible.</div>
    <button class="go guest" type="submit">Login as Accountant</button>
  </form>
  <form method="post" action="/login" class="pane " id="guest">
    <input type="hidden" name="role" value="guest">
    
    <div class="note">View only: see the saved sheets, USD rates, P&amp;L, graphs and comparisons. Guests cannot upload, remove sheets or change rates.</div>
    <button class="go guest" type="submit">Continue as Guest</button>
  </form>
</div>
<script>
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
  document.querySelectorAll('.tab,.pane').forEach(x=>x.classList.remove('active'));
  t.classList.add('active'); document.getElementById(t.dataset.pane).classList.add('active');
});
</script></body></html>